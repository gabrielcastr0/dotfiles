{
  "diff_view_style": "unified",
  "cli_default_open_behavior": "new_window",
  "icon_theme": "Material Icon Theme",
  "theme": "Catppuccin Mocha",

  "vim_mode": true,

  "ui_font_size": 18,
  "buffer_font_size": 20,
  "buffer_font_family": "Maple Mono",

  "current_line_highlight": "none",
  "cursor_shape": "block",
  "cursor_blink": false,

  "tab_size": 2,
  "hard_tabs": false,

  "format_on_save": "on",
  "formatter": "auto",
  "enable_language_server": true,

  "vertical_scroll_margin": 0,
  "relative_line_numbers": "enabled",

  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,

  "tab_bar": {
    "show": false
  },

  "tabs": {
    "git_status": true
  },

  "inlay_hints": {
    // Enable this in the language-specific LSP configuration below.
    "enabled": false
  },

  "scrollbar": {
    "show": "never"
  },

  "toolbar": {
    "breadcrumbs": true,
    "quick_actions": false
  },

  "project_panel": {
    "button": true,
    "dock": "left",
    "git_status": true
  },

  "outline_panel": {
    "dock": "right"
  },

  "collaboration_panel": {
    "dock": "left"
  },

  "notification_panel": {
    "dock": "left"
  },

  // LSP configuration
  "lsp": {
    "tailwindcss-language-server": {
      "settings": {
        "classAttributes": ["class", "className", "ngClass", "styles"]
      }
    },

    "gppls": {},
    "rust-analyzer": {}
  },

  "languages": {
    // See:
    // https://zed.dev/docs/languages/javascript
    // https://zed.dev/docs/languages/typescript
    "JavaScript": {
      "tab_size": 2
      // "formatter": "language_server",
    },

    "TypeScript": {
      "inlay_hints": {
        "enabled": false,
        "show_parameter_hints": false,
        "show_other_hints": true,
        "show_type_hints": true
      },
      "tab_size": 2
    },

    "JSON": {
      "tab_size": 2
    },

    "Python": {
      "formatter": {
        "language_server": {
          "name": "ruff"
        }
      },
      "language_servers": ["pyright", "ruff"]
    }
  }
}
