#!/bin/bash
# Update Neovim AppImage to the latest version

set -e

INSTALL_DIR="$HOME/.local/bin"
NVIM_PATH="$INSTALL_DIR/nvim"
TEMP_FILE="/tmp/nvim-linux-x86_64.appimage"

# Get current version
if [ -x "$NVIM_PATH" ]; then
    CURRENT=$("$NVIM_PATH" --version | head -1 | cut -d' ' -f2)
    echo "Current version: $CURRENT"
else
    echo "Neovim not found at $NVIM_PATH"
    CURRENT="none"
fi

# Get latest version
LATEST=$(curl -s https://api.github.com/repos/neovim/neovim/releases/latest | grep '"tag_name"' | cut -d'"' -f4)
echo "Latest version:  $LATEST"

if [ "$CURRENT" = "$LATEST" ]; then
    echo "Already up to date."
    exit 0
fi

echo "Downloading $LATEST..."
curl -L -o "$TEMP_FILE" "https://github.com/neovim/neovim/releases/download/$LATEST/nvim-linux-x86_64.appimage"
chmod u+x "$TEMP_FILE"

mkdir -p "$INSTALL_DIR"
mv "$TEMP_FILE" "$NVIM_PATH"

echo "Updated to $LATEST"
