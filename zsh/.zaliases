# Personal aliases layered on top of Omarchy's defaults.

# ---------- GENERAL ----------
alias c='clear'
alias cls='clear'
alias e='exit'

# ---------- EDITOR ----------
alias vim='nvim'
alias nvim-scratch='NVIM_APPNAME=nvim-scratch nvim'

# ---------- FZF ----------
[[ -x "$HOME/scripts/fzf_listoldfiles.sh" ]] && alias nlof="$HOME/scripts/fzf_listoldfiles.sh"

# ---------- ZOXIDE ----------
[[ -x "$HOME/scripts/zoxide_openfiles_nvim.sh" ]] && alias nzo="$HOME/scripts/zoxide_openfiles_nvim.sh"

# ---------- LS & TREE REPLACEMENTS ----------
alias tree="tree -L 3 -a -I '.git' --charset X"
alias dtree="tree -L 3 -a -d -I '.git' --charset X"
command -v lstr >/dev/null 2>&1 && alias lstr='lstr --icons'

# ---------- GIT ----------
alias gt='git'
alias gaa='git add .'
alias gs='git status -s'
alias gc='git commit -m'
alias glog='git log --oneline --graph --all'
alias gh-create='gh repo create --private --source=. --remote=origin && git push -u --all && gh browse'
alias lg='lazygit'

# ---------- DOCKER ----------
alias lzd='lazydocker'

# ---------- MEDIA ----------
alias mpds='mpd ~/.config/mpd/mpd.conf'
